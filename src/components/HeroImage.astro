---
import { getHeroSources } from '../lib/hero-sources.ts';

const hero = await getHeroSources();
---

{
  hero && (
    <div class="hero-media" data-slot="hero" data-slot-state="image" style={`background-image:url(${hero.lqip})`}>
      <picture>
        <source media={hero.portraitMedia} type="image/avif" srcset={hero.portrait.avif} sizes={hero.portrait.sizes} />
        <source media={hero.portraitMedia} type="image/webp" srcset={hero.portrait.webp} sizes={hero.portrait.sizes} />
        <source type="image/avif" srcset={hero.landscape.avif} sizes={hero.landscape.sizes} />
        <source type="image/webp" srcset={hero.landscape.webp} sizes={hero.landscape.sizes} />
        <img
          src={hero.fallback.src}
          srcset={hero.landscape.webp}
          sizes={hero.landscape.sizes}
          width={hero.fallback.width}
          height={hero.fallback.height}
          alt=""
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>
  )
}

<style>
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -4;
    background-size: cover;
    background-position: center;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global([data-theme='light']) .hero-media {
    opacity: 0.28;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .hero-media {
      opacity: 0.28;
    }
  }
</style>
