---
import { profile } from '../data/profile.ts';
import { navSections } from '../lib/nav.ts';
---

<button class="icon-btn hamburger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
  <span class="lines" aria-hidden="true"><span></span><span></span></span>
</button>

<dialog id="mobile-menu" class="menu" aria-label="Site menu">
  <div class="menu-inner">
    <div class="menu-top">
      <span class="silk">kiran.v</span>
      <button class="icon-btn" type="button" aria-label="Close menu" data-menu-close>
        <span class="lines lines-x" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
    <ol class="menu-list">
      {
        navSections.map((section, index) => (
          <li>
            <a href={`#${section}`} data-menu-link>
              <span class="silk menu-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="menu-label">/{section}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="menu-foot">
      <a class="silk" href={profile.github} rel="noopener">GitHub</a>
      <a class="silk" href={profile.linkedin} rel="noopener">LinkedIn</a>
      <a class="silk" href={`mailto:${profile.email}`}>Email</a>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/menu.ts';
</script>

<style>
  .hamburger {
    display: none;
  }

  :global(html[data-js]) .hamburger {
    display: inline-flex;
  }

  @media (min-width: 48rem) {
    :global(html[data-js]) .hamburger {
      display: none;
    }
  }

  .lines {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 0.625rem;
  }

  .lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 0.125rem;
    background: currentColor;
    transition: transform var(--dur-2);
  }

  .lines span:first-child {
    top: 0;
  }

  .lines span:last-child {
    bottom: 0;
  }

  .lines-x span:first-child {
    transform: translateY(0.25rem) rotate(45deg);
  }

  .lines-x span:last-child {
    transform: translateY(-0.25rem) rotate(-45deg);
  }

  .menu {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(circle, var(--board-line-minor) 1px, transparent 1.5px) 50% 0 / var(--pitch) var(--pitch),
      var(--bg);
    color: var(--text);
  }

  .menu[open] {
    animation: menu-in var(--dur-2) var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: env(safe-area-inset-top) var(--gutter-r) env(safe-area-inset-bottom) var(--gutter-l);
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-h);
  }

  .menu-list {
    position: relative;
    margin-block: var(--s-5);
  }

  .menu-list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--gutter) / -2);
    width: 2px;
    background: var(--accent);
  }

  .menu-list a {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 3.5rem;
    border-bottom: 1px solid var(--grid);
  }

  .menu-index {
    color: var(--muted);
  }

  .menu-label {
    font-family: var(--font-display-stack);
    font-size: clamp(1.75rem, 8vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .menu-foot {
    display: flex;
    gap: var(--s-4);
    margin-top: auto;
    padding-block: var(--s-4);
  }

  .menu-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
  }

  @media (max-height: 30rem) and (orientation: landscape) {
    .menu-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-6);
      margin-block: var(--s-2);
    }
  }
</style>
