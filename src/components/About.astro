---
import { profile } from '../data/profile.ts';
import ImageSlot from './ImageSlot.astro';
import SectionLabel from './SectionLabel.astro';

const { certification } = profile;
---

<section id="about" class="section" aria-labelledby="about-title">
  <div data-content>
    <span class="rail" data-trace-anchor="rail-l"></span>
    <span class="rail rail-right" data-trace-anchor="rail-r"></span>
    <SectionLabel section="about" index="01" />
    <h2 id="about-title" class="section-title">From Electrical Engineering to Software Engineering</h2>
    <div class="about-grid">
      <div class="about-text">
        <p class="summary measure">{profile.summary}</p>
        <p class="story measure" data-story>{profile.story}</p>
        <ul class="parts">
          {
            profile.education.map((entry) => (
              <li>
                <span class="silk edu">EDU</span>
                <span>{entry.degree}, {entry.school}, {entry.detail}</span>
              </li>
            ))
          }
        </ul>
        {
          certification.url ? (
            <a class="cert cert-link" href={certification.url} rel="noopener">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M8 1.5l5.5 2V8c0 3.2-2.3 5.4-5.5 6.5C4.8 13.4 2.5 11.2 2.5 8V3.5ZM5.5 8l2 2 3.5-4" /></svg>
              <span class="cert-name">{certification.name}</span>
              <span class="silk cert-tag">VERIFIED CREDENTIAL</span>
            </a>
          ) : (
            <p class="cert">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M8 1.5l5.5 2V8c0 3.2-2.3 5.4-5.5 6.5C4.8 13.4 2.5 11.2 2.5 8V3.5ZM5.5 8l2 2 3.5-4" /></svg>
              <span class="cert-name">{certification.name}</span>
              <span class="silk cert-tag">VERIFIED CREDENTIAL</span>
            </p>
          )
        }
      </div>
      <figure class="about-figure">
        <div class="frame">
          <span class="tick tick-tl"></span><span class="tick tick-tr"></span><span class="tick tick-bl"></span><span class="tick tick-br"></span>
          <div class="frame-inner"><ImageSlot slot="keweenaw" /></div>
        </div>
        <figcaption class="silk">47.12°N 88.57°W · Houghton, in the Keweenaw</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .rail {
    position: absolute;
    top: 0;
    left: calc(var(--gutter) / -2);
    width: 0;
    height: 0;
  }

  .rail-right {
    left: auto;
    right: calc(var(--gutter) / -2);
  }

  .about-grid {
    display: grid;
    gap: var(--s-7);
  }

  .summary {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.4;
  }

  .story {
    margin-top: var(--s-5);
  }

  .parts {
    margin-top: var(--s-5);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .parts li {
    display: flex;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--grid);
  }

  .edu {
    flex: none;
    color: var(--accent);
    line-height: 1.75;
  }

  .cert {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-5);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--accent);
    border-radius: var(--r-1);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .cert-link {
    min-height: 2.75rem;
  }

  .cert svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }

  .cert-name {
    flex: 1 1 12rem;
  }

  .cert-tag {
    color: var(--accent);
  }

  .frame {
    position: relative;
  }

  .frame-inner {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--grid);
    border-radius: var(--r-2);
    background: var(--bg);
  }

  .tick {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border: 0 solid var(--line-strong);
  }

  .tick-tl {
    top: -0.375rem;
    left: -0.375rem;
    border-width: 1px 0 0 1px;
  }

  .tick-tr {
    top: -0.375rem;
    right: -0.375rem;
    border-width: 1px 1px 0 0;
  }

  .tick-bl {
    bottom: -0.375rem;
    left: -0.375rem;
    border-width: 0 0 1px 1px;
  }

  .tick-br {
    bottom: -0.375rem;
    right: -0.375rem;
    border-width: 0 1px 1px 0;
  }

  figcaption {
    margin-top: var(--s-3);
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: clamp(1rem, 2vw, 2rem);
    }
  }
</style>
