---
import { navSections } from '../lib/nav.ts';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <nav class="nav-bar" aria-label="Primary">
    <a class="brand" href="#hero">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="#0B1218"></rect>
        <path fill="#C47A4A" d="M9 2h3v5H9zM14.500 2h3v5h-3zM20 2h3v5h-3zM9 25h3v5H9zM14.500 25h3v5h-3zM20 25h3v5h-3zM2 9h5v3H2zM2 14.500h5v3H2zM2 20h5v3H2zM25 9h5v3h-5zM25 14.500h5v3h-5zM25 20h5v3h-5z"></path>
        <rect x="7" y="7" width="18" height="18" rx="2" fill="#C47A4A"></rect>
        <path fill="#0B1218" d="M11 11H21V21H11Z"></path>
        <circle cx="14" cy="14" r="1.6" fill="#E29A64"></circle>
      </svg>
      <span class="silk">kiran.v</span>
    </a>
    <ul class="nav-links">
      {navSections.map((section) => <li><a class="silk nav-link" href={`#${section}`}>/{section}</a></li>)}
    </ul>
    <div class="nav-actions">
      <ThemeToggle />
      <MobileMenu />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid var(--grid);
    background: var(--bg);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(0.75rem) saturate(140%);
    }
  }

  .nav-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    width: min(100% - var(--gutter-l) - var(--gutter-r), 80rem);
    min-height: var(--nav-h);
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    min-width: 2.75rem;
    color: var(--text);
  }

  .brand-mark {
    width: 1.5rem;
    height: 1.5rem;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    order: 3;
    width: 100%;
  }

  :global(html[data-js]) .nav-links {
    display: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding-inline: var(--s-2);
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: var(--s-2);
    bottom: 0.5rem;
    height: 0.125rem;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-1);
  }

  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .nav-link:hover::after {
      transform: scaleX(1);
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  @media (min-width: 48rem) {
    .nav-bar {
      flex-wrap: nowrap;
    }

    .nav-links,
    :global(html[data-js]) .nav-links {
      display: flex;
      flex-wrap: nowrap;
      order: 0;
      width: auto;
      margin-left: auto;
    }

    .nav-actions {
      margin-left: 0;
    }
  }

  @media (max-width: 47.99rem) {
    :global(html:not([data-js])) .site-header {
      position: static;
    }
  }
</style>
