---
import type { SkillGroup } from '../types.ts';

interface Props {
  group: SkillGroup;
}

const { group } = Astro.props;
---

<div class="bank" data-group={group.label}>
  <h3 class="silk bank-label">BANK {group.bank} · {group.label}</h3>
  <ul class="parts">
    {group.parts.map((part) => <li class="part" data-part>{part}</li>)}
  </ul>
  {group.note && <p class="note">{group.note}</p>}
</div>

<style>
  .bank {
    container-type: inline-size;
    padding-top: var(--s-4);
    border-top: 1px solid var(--grid);
  }

  .bank-label {
    font-family: var(--font-mono-stack);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    color: var(--silk);
  }

  .parts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }

  .part {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding-inline: var(--s-3);
    border: 1px solid var(--grid);
    border-radius: var(--r-1);
    background: var(--surface);
    font-family: var(--font-mono-stack);
    font-size: var(--fs-mono);
    line-height: 1.3;
    color: var(--text);
  }

  .part::before,
  .part::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0.375rem;
    background: var(--accent);
    opacity: 0.7;
    transition: opacity var(--dur-1);
  }

  .part::before {
    left: 0;
  }

  .part::after {
    right: 0;
  }

  @media (hover: hover) {
    .part:hover::before,
    .part:hover::after {
      opacity: 1;
    }
  }

  .note {
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--muted);
  }

  @container (min-width: 28rem) {
    .part {
      min-height: 2.25rem;
    }
  }
</style>
