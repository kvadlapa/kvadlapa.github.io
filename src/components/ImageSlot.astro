---
import { Picture } from 'astro:assets';
import { slotDef } from '../data/image-slots.ts';
import { slotImage, slotWidths } from '../lib/images.ts';
import type { SlotName } from '../types.ts';
import SlotFallback from './SlotFallback.astro';

interface Props {
  slot: SlotName;
}

const { slot } = Astro.props;
const def = slotDef(slot);
const image = slotImage(slot);
---

{
  image ? (
    <div class="slot" data-slot={slot} data-slot-state="image">
      <Picture
        src={image}
        alt={def.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={slotWidths(image)}
        sizes={def.sizes}
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <SlotFallback slot={slot} />
  )
}

<style>
  .slot {
    width: 100%;
    height: 100%;
  }

  .slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
