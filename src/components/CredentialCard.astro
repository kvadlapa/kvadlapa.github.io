---
import { profile } from '../data/profile.ts';
import SlotFallback from './SlotFallback.astro';

interface Props {
  art: boolean;
}

const { art } = Astro.props;
---

<div class="badge-slot">
  {art && <SlotFallback slot="hero" />}
  <div class="badge" id="badge" data-credential data-badge-state="granted">
    <span class="scan" aria-hidden="true"></span>
    <span class="lanyard"></span>
    <div class="badge-head">
      <span class="silk badge-label">CREDENTIAL</span>
      <span class="contact-chip"></span>
    </div>
    <div class="badge-id">
      <span class="monogram">KV</span>
      <p class="badge-name">{profile.name}</p>
    </div>
    <div class="badge-status">
      <span class="status-string st st-scanning" aria-hidden="true">SCANNING…</span>
      <span class="status-string st st-verifying" aria-hidden="true">VERIFYING…</span>
      <span class="status-string st st-granted" aria-hidden="true" data-status="granted"><span class="led" data-status="granted">●</span> ACCESS GRANTED</span>
      <span class="sr-only">Access granted</span>
    </div>
    <dl class="badge-rows mono">
      <div><dt>role</dt> <dd><span class="val" style="--i:0">{profile.role}</span></dd></div>
      <div><dt>stack</dt> <dd><span class="val" style="--i:1">{profile.stack}</span></dd></div>
      <div><dt>location</dt> <dd><span class="val" style="--i:2">{profile.location}</span></dd></div>
      <div class="json-row"><dt>"open_to_work":</dt> <dd><span class="val json-true" style="--i:3">true</span></dd></div>
    </dl>
  </div>
  <span class="trace-pad" data-trace-anchor="start"></span>
  <script is:inline>
    (function () {
      var card = document.getElementById('badge');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      card.dataset.badgeState = 'scanning';
      new IntersectionObserver(
        function (entries, observer) {
          if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
          observer.disconnect();
          card.dataset.run = '';
          setTimeout(function () { card.dataset.badgeState = 'verifying'; }, 560);
          setTimeout(function () { card.dataset.badgeState = 'granted'; }, 980);
        },
        { threshold: 0.15 },
      ).observe(card);
    })();
  </script>
</div>

<style>
  .badge-slot {
    position: relative;
    width: 100%;
    max-width: 23.75rem;
  }

  .badge {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding: var(--card-pad);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-3);
    background: var(--surface);
  }

  .lanyard {
    display: block;
    width: 2.75rem;
    height: 0.5rem;
    margin: 0 auto var(--s-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-1);
    background: var(--bg);
  }

  .badge-head,
  .badge-id {
    display: flex;
    align-items: center;
  }

  .badge-head {
    justify-content: space-between;
    margin-bottom: var(--s-4);
  }

  .badge-label {
    color: var(--silk);
  }

  /* Smart-card contact: a 2x3 grid of pads on a copper body. */
  .contact-chip {
    width: 2.5rem;
    height: 1.875rem;
    border-radius: var(--r-1);
    background:
      linear-gradient(var(--surface) 0 0) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--surface) 0 0) 0 33.333% / 100% 1px no-repeat,
      linear-gradient(var(--surface) 0 0) 0 66.667% / 100% 1px no-repeat,
      var(--copper);
  }

  .badge-id {
    gap: var(--s-3);
  }

  .monogram {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-1);
    font-family: var(--font-mono-stack);
    font-weight: 500;
    color: var(--text);
  }

  .badge-name {
    font-family: var(--font-display-stack);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
  }

  .badge-status {
    display: grid;
    align-items: center;
    min-height: 1.5rem;
    margin-block: var(--s-3);
  }

  .st {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-1);
  }

  .st-scanning,
  .st-verifying {
    color: var(--muted);
  }

  [data-badge-state='scanning'] .st-scanning,
  [data-badge-state='verifying'] .st-verifying,
  [data-badge-state='granted'] .st-granted {
    opacity: 1;
    visibility: visible;
  }

  .led {
    display: inline-block;
  }

  .badge-rows {
    border-top: 1px solid var(--grid);
    padding-top: var(--s-3);
  }

  .badge-rows div {
    display: flex;
    gap: var(--s-3);
    padding-block: 0.125rem;
  }

  .badge-rows dt {
    flex: none;
    min-width: 4.5rem;
    color: var(--muted);
  }

  .badge-rows .json-row {
    gap: 0.5ch;
  }

  .val {
    position: relative;
    display: inline-block;
    color: var(--text);
  }

  .json-true {
    color: var(--accent);
  }

  .val::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-1);
    background: var(--surface-2);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 240ms var(--ease-out) calc(var(--i) * 60ms);
  }

  [data-badge-state='scanning'] .val::after,
  [data-badge-state='verifying'] .val::after {
    transform: scaleX(1);
    transition: none;
  }

  /* The box matches the card, so the line at its bottom edge travels the card's real height. */
  .scan {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      0deg,
      var(--accent) 0 0.125rem,
      color-mix(in srgb, var(--accent) 18%, transparent) 0.125rem,
      transparent 3.125rem
    );
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
    transition: opacity var(--dur-1);
  }

  [data-badge-state='scanning'][data-run] .scan {
    opacity: 1;
    animation: scan 560ms cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }

  @keyframes scan {
    to {
      transform: translateY(0);
    }
  }

  [data-run][data-badge-state='granted'] .led {
    animation: led-pop var(--dur-2) var(--ease-out);
  }

  [data-run][data-badge-state='granted']::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--status) 40%, transparent);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    animation: ring-out 400ms var(--ease-out);
  }

  @keyframes led-pop {
    from {
      transform: scale(0.6);
    }
  }

  @keyframes ring-out {
    from {
      opacity: 1;
    }
  }

  .trace-pad {
    position: absolute;
    left: 50%;
    bottom: -0.1875rem;
    z-index: 2;
    width: 0.75rem;
    height: 0.375rem;
    margin-left: -0.375rem;
    background: var(--accent);
  }

  @media (min-width: 56rem) {
    .badge-slot {
      width: var(--badge-w);
    }
  }

  @media (max-height: 30rem) and (orientation: landscape) {
    .badge-slot {
      width: 100%;
    }

    .badge-head {
      margin-bottom: var(--s-1);
    }

    .badge-status {
      margin-block: var(--s-1);
    }

    .badge-rows div {
      padding-block: 0;
    }

    .badge {
      padding: var(--s-4);
    }

    .badge-rows {
      font-size: 0.75rem;
    }

    .badge-rows div {
      gap: var(--s-2);
    }

    .badge-rows dt {
      min-width: 4rem;
    }

    .val {
      white-space: nowrap;
    }
  }
</style>
